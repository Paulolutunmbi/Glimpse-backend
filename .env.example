PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/glimpse
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed by CORS.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
CLIENT_ORIGIN_BASE_PORT=5173
CLIENT_APP_URL=http://localhost:5173
CLIENT_RESET_PASSWORD_URL=http://localhost:3000/reset-password
CLIENT_POST_ROUTE_PREFIX=/post

# SMTP with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Glimpse <your-gmail-address@gmail.com>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_SEND_TIMEOUT_MS=9000
SMTP_LOGGER=false
SMTP_DEBUG=false
VERIFY_SMTP_ON_STARTUP=false
