PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/glimpse
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed by CORS.
CLIENT_APP_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173
CLIENT_RESET_PASSWORD_URL=http://localhost:5173/reset-password
CLIENT_POST_ROUTE_PREFIX=/post

# Resend transactional email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Glimpse <no-reply@yourdomain.com>"
EMAIL_SEND_TIMEOUT_MS=10000
FORGOT_PASSWORD_EMAIL_TIMEOUT_MS=15000

# Render production values:
# NODE_ENV=production
# CLIENT_APP_URL=https://glimpse-theta-swart.vercel.app
# CLIENT_ORIGINS=https://glimpse-theta-swart.vercel.app
# CLIENT_RESET_PASSWORD_URL=https://glimpse-theta-swart.vercel.app/reset-password
